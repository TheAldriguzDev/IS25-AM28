<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" prefHeight="939.0" prefWidth="1130.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am28.Client.UI.GUI.SceneControllers.ShipConstructionController">
    <HBox spacing="20.0">
      <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="1018.0" prefWidth="818.0" HBox.hgrow="ALWAYS">
         <children>

              <!-- Scroll con FlowPane dinamico -->
              <ScrollPane fx:id="tileScrollPane" fitToHeight="true" fitToWidth="true">
                  <FlowPane fx:id="tileFlow" hgap="5" prefWrapLength="800" vgap="5">
                      <padding>
                          <Insets bottom="10" left="10" right="10" top="10" />
                      </padding>
                  </FlowPane>
              </ScrollPane>

             <!-- shipContainer used to display the selected tile commands -->
            <VBox fx:id="shipContainer" managed="false" prefHeight="200.0" prefWidth="100.0" visible="false">
               <children>
                   <HBox alignment="CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
                     <Button fx:id="deselectButton" mnemonicParsing="false" onAction="#handleDeselectTile" text="Deselect" />
                     <Region HBox.hgrow="ALWAYS" />
                       <Button fx:id="rotateRightButton" mnemonicParsing="false" onAction="#handleRotateRight">
                          <graphic>
                              <ImageView fitHeight="31.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true">
                                  <Image url="@../../imgs/rotate.png" />
                              </ImageView>
                          </graphic>
                       </Button>
                       <ImageView fx:id="selectedComponentImage" fitHeight="150.0" fitWidth="105.0" pickOnBounds="true" preserveRatio="true">
                           <Image url="@../../imgs/tiles/cannon/GT-new_tiles_16_for%20web103.jpg" />
                       </ImageView>
                       <Button fx:id="rotateLeftButton" mnemonicParsing="false" onAction="#handleRotateLeft">
                          <graphic>
                              <ImageView fitHeight="31.0" fitWidth="41.0" pickOnBounds="true" preserveRatio="true" scaleX="-1.0">
                                  <Image url="@../../imgs/rotate.png" />
                              </ImageView>
                          </graphic>
                       </Button>
                     <Region HBox.hgrow="ALWAYS" />
                     <Button fx:id="reserveButton" mnemonicParsing="false" onAction="#handleReserveTile" text="Reserve" />
                   </HBox>
                  <Region VBox.vgrow="ALWAYS" />

                   <StackPane fx:id="shipStackPane" maxHeight="-Infinity" maxWidth="-Infinity">
                       <!-- Immagine della nave -->
                       <ImageView fx:id="shipImageView" fitWidth="816.0" preserveRatio="true">
                           <image>
                               <Image url="@../../imgs/cardboard/level_2.jpg" />
                           </image>
                       </ImageView>
                       <GridPane fx:id="reservedComponentGrid" alignment="TOP_RIGHT" hgap="3.0" layoutX="584.0" layoutY="20.0" prefHeight="105.0" prefWidth="210.0" vgap="2.0">
                           <columnConstraints>
                               <ColumnConstraints prefWidth="105.0" />
                               <ColumnConstraints prefWidth="105.0" />
                           </columnConstraints>
                           <rowConstraints>
                               <RowConstraints prefHeight="105.0" />
                           </rowConstraints>
                        <StackPane.margin>
                           <Insets right="19.0" top="20.0" />
                        </StackPane.margin>
                       </GridPane>

                       <!-- Griglia sopra l'immagine -->
                       <GridPane fx:id="shipGrid" alignment="CENTER" hgap="2.5" prefHeight="459.0" prefWidth="659.0" vgap="2.5">
                           <rowConstraints>
                               <RowConstraints minHeight="105.0" prefHeight="105.0" />
                               <RowConstraints minHeight="105.0" prefHeight="105.0" />
                               <RowConstraints minHeight="105.0" prefHeight="105.0" />
                               <RowConstraints minHeight="105.0" prefHeight="105.0" />
                               <RowConstraints minHeight="105.0" prefHeight="105.0" />
                           </rowConstraints>
                           <columnConstraints>
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                               <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                           </columnConstraints>
                       </GridPane>
                   </StackPane>
                   <Region VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

             <!-- viewShipContainer used to see the selected player ship -->
             <VBox managed="false" prefHeight="200.0" prefWidth="100.0" visible="false">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0">
                     <children>
                        <Label fx:id="viewPlayerShipLabel" text="You are now viewing Player 1's ship">
                           <font>
                              <Font size="32.0" />
                           </font>
                        </Label>
                        <Button fx:id="goBackToConstructionButton" mnemonicParsing="false" text="Resume Ship Construction" />
                     </children>
                  </VBox>
                  <Region VBox.vgrow="ALWAYS" />
                  <StackPane fx:id="viewOtherShipStackPane" maxHeight="-Infinity" maxWidth="-Infinity">
                     <children>
                        <ImageView fx:id="viewOtherShipImage" fitWidth="816.0" preserveRatio="true">
                           <image>
                              <Image url="@../../imgs/cardboard/level_2.jpg" />
                           </image>
                        </ImageView>
                        <GridPane fx:id="viewOtherShipGrid" alignment="CENTER" hgap="2.5" prefHeight="459.0" prefWidth="659.0" vgap="2.5">
                           <rowConstraints>
                              <RowConstraints minHeight="105.0" prefHeight="105.0" />
                              <RowConstraints minHeight="105.0" prefHeight="105.0" />
                              <RowConstraints minHeight="105.0" prefHeight="105.0" />
                              <RowConstraints minHeight="105.0" prefHeight="105.0" />
                              <RowConstraints minHeight="105.0" prefHeight="105.0" />
                           </rowConstraints>
                           <columnConstraints>
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                              <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                           </columnConstraints>
                        </GridPane>
                     </children>
                  </StackPane>
                  <Region VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </StackPane>

        <!-- Colonna laterale -->
        <VBox fx:id="sidePanel" alignment="TOP_CENTER" maxWidth="450.0" spacing="20.0" HBox.hgrow="ALWAYS">
            <!-- Timer -->
            <HBox fx:id="timerContainer" alignment="CENTER" spacing="10.0">
                <Label fx:id="timerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="55 sec" />
            <Region prefHeight="36.0" prefWidth="46.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="flipTimerButton" onAction="#handleFlipTimer" style="-fx-background-color: orange; -fx-font-weight: bold;" text="Flip timer" />
            </HBox>

            <!-- Carte subdeck -->
            <ImageView fx:id="subDeckOne" fitHeight="120.0" onMouseClicked="#handleViewSubDeck" preserveRatio="true" rotate="90.0" VBox.vgrow="ALWAYS">
                <Image url="@../../imgs/subdeck.png" />
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </ImageView>
            <ImageView fx:id="subDeckTwo" fitHeight="120.0" onMouseClicked="#handleViewSubDeck" preserveRatio="true" rotate="90.0" VBox.vgrow="ALWAYS">
                <Image url="@../../imgs/subdeck.png" />
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </ImageView>
            <ImageView fx:id="subDeckThree" fitHeight="120.0" onMouseClicked="#handleViewSubDeck" preserveRatio="true" rotate="90.0" VBox.vgrow="ALWAYS">
                <Image url="@../../imgs/subdeck.png" />
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </ImageView>

            <!-- Board level -->
            <ImageView fx:id="boardImageView" fitHeight="150.0" preserveRatio="true" VBox.vgrow="ALWAYS">
                <Image url="@../../imgs/cardboard/level-2-board.png" />
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </ImageView>
         <Region VBox.vgrow="ALWAYS" />

            <!-- Sezione navi altri player -->
            <VBox alignment="CENTER" maxWidth="Infinity" spacing="10.0" style="-fx-border-color: white; -fx-border-width: 2; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="View other ships" />
                <GridPane fx:id="viewOtherShipsGrid" hgap="5.0" vgap="5.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                </GridPane>
            </VBox>
         <Button fx:id="confirmShipButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleConfirmShip" text="Ship Ready" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</StackPane>
