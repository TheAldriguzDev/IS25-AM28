<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>


<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am28.Client.UI.GUI.SceneControllers.PopulateShipController">
   <children>
      <VBox alignment="TOP_CENTER" spacing="15.0">
         <children>
            <Label text="Select which lifeForm you want to add!">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <GridPane hgap="2.5" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <ToggleButton mnemonicParsing="false" prefHeight="37.0" prefWidth="125.0" styleClass="purple" text="Alien">
                     <toggleGroup>
                        <ToggleGroup fx:id="lifeFormsToggles" />
                     </toggleGroup>
                  </ToggleButton>
                  <ToggleButton mnemonicParsing="false" prefHeight="37.0" prefWidth="110.0" styleClass="brown" text="Alien" toggleGroup="$lifeFormsToggles" GridPane.columnIndex="1" />
                  <ToggleButton mnemonicParsing="false" prefHeight="37.0" prefWidth="211.0" styleClass="white" text="Astronaut (2X)" toggleGroup="$lifeFormsToggles" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" />
               </children>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
      <VBox fx:id="fixShipVBox" alignment="CENTER" stylesheets="@../style.css">
         <children>
            <TextFlow fx:id="populateShipLabel" textAlignment="CENTER" />
            <StackPane fx:id="imagePane" maxHeight="-Infinity" maxWidth="-Infinity">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <ImageView fx:id="shipImageView" fitWidth="816.0" preserveRatio="true" />
                  <GridPane fx:id="shipGrid" alignment="CENTER" hgap="2.5" prefHeight="459.0" prefWidth="659.0" vgap="2.5">
                     <rowConstraints>
                        <RowConstraints minHeight="105.0" prefHeight="105.0" />
                        <RowConstraints minHeight="105.0" prefHeight="105.0" />
                        <RowConstraints minHeight="105.0" prefHeight="105.0" />
                        <RowConstraints minHeight="105.0" prefHeight="105.0" />
                        <RowConstraints minHeight="105.0" prefHeight="105.0" />
                     </rowConstraints>
                     <columnConstraints>
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                        <ColumnConstraints minWidth="105.0" prefWidth="105.0" />
                     </columnConstraints>
                  </GridPane>
               </children>
            </StackPane>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</HBox>
